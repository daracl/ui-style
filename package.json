{
  "name": "@daracl/ui-style",
  "version": "0.0.7",
  "description": "Daracl UI shared SCSS: design tokens, themes, mixins and utilities",
  "author": {
    "name": "darainfo",
    "email": "darainfosys@gmail.com",
    "url": "https://ui.daracl.com"
  },
  "license": "MIT",
  "keywords": [
    "daracl",
    "darainfo",
    "scss",
    "sass",
    "design-tokens",
    "theme"
  ],
  "homepage": "https://github.com/daracl/ui-style",
  "bugs": {
    "url": "https://github.com/daracl/ui-style/issues",
    "email": "darainfosys@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daracl/ui-style.git"
  },
  "sideEffects": [
    "*.css"
  ],
  "sass": "./src/index.scss",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "sass": "./src/index.scss",
      "default": "./src/index.scss"
    },
    "./abstracts": {
      "sass": "./src/abstracts/_index.scss",
      "default": "./src/abstracts/_index.scss"
    },
    "./tokens": {
      "sass": "./src/tokens/_index.scss",
      "default": "./src/tokens/_index.scss"
    },
    "./themes": {
      "sass": "./src/themes/_index.scss",
      "default": "./src/themes/_index.scss"
    },
    "./base": {
      "sass": "./src/base/_index.scss",
      "default": "./src/base/_index.scss"
    },
    "./utilities": {
      "sass": "./src/utilities/_index.scss",
      "default": "./src/utilities/_index.scss"
    },
    "./style.css": "./dist/style.css",
    "./theme-vars.css": "./dist/theme-vars.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "abstracts",
    "tokens",
    "themes",
    "base",
    "utilities",
    "index.scss",
    "docs/guide.html",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "sass": ">=1.80.0"
  },
  "peerDependenciesMeta": {
    "sass": {
      "optional": true
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "build:guide": "node scripts/build-guide.mjs",
    "build:css": "node scripts/build.mjs --css-only",
    "build:css:min": "node scripts/build.mjs --min-only",
    "start": "yarn build && node scripts/serve.mjs --open",
    "serve": "node scripts/serve.mjs",
    "lint:rules": "node scripts/lint-rules.mjs",
    "test": "node scripts/build.mjs && node scripts/lint-rules.mjs && node scripts/verify.mjs",
    "prepack": "yarn build"
  },
  "devDependencies": {
    "sass": "^1.80.2"
  }
}
